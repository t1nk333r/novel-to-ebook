{
  "name": "storvi",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.24.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "pnpm --filter ui build",
    "start": "NODE_ENV=production bun run src/index.ts",
    "dev:server": "bun --watch run src/index.ts",
    "dev:ui": "pnpm --filter ui dev -- --host",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:ui\"",
    "test": "bun test",
    "typecheck:server": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc -b ui/tsconfig.json",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:ui",
    "lint": "pnpm --filter ui lint",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build",
    "typegen": "pnpm typegen:server && pnpm typegen:ui",
    "typegen:server": "kysely-codegen --dialect bun-sqlite --out-file src/db/types.d.ts",
    "typegen:ui": "pnpm --filter ui typegen",
    "prestart": "bun run src/preflight.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.0",
    "@types/opentype.js": "^1.3.9",
    "@types/sanitize-html": "^2.16.0",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1",
    "kysely-codegen": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@epubkit/epub-gen-memory": "1.0.10-aplha.14",
    "@extractus/article-extractor": "^8.0.20",
    "@ghostery/adblocker-puppeteer": "^2.14.1",
    "@google/genai": "^2.19.0",
    "@mozilla/readability": "^0.6.0",
    "@scalar/hono-api-reference": "^0.10.0",
    "blurhash": "^2.0.5",
    "cheerio": "^1.2.0",
    "cron": "^4.4.0",
    "epub": "^2.1.1",
    "hono": "^4.13.5",
    "hono-zod-openapi": "^1.1.1",
    "jsdom": "^28.1.0",
    "kysely": "^0.28.11",
    "kysely-bun-worker": "^1.2.1",
    "opentype.js": "^1.3.4",
    "pdftoimg-js": "^0.2.5",
    "puppeteer": "^25.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-block-resources": "^2.4.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "remove-markdown": "^0.6.3",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^4.3.6"
  }
}
