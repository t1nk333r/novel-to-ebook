DATABASE_URL=./storvi.sqlite
DATA_PATH=./data
HOST=127.0.0.1
PORT=3000
# Required when HOST is not loopback, unless ALLOW_INSECURE_BIND is set.
# This file is committed: leave every credential empty. Real values belong in
# the environment (or ~/.config/storvi/<name> for this deployment), never here.
API_TOKEN=
# Permits a tokenless non-loopback bind. Set this ONLY when something outside
# the process limits who can reach the port — for example a Docker port
# published to 127.0.0.1. Never set it on a LAN or public interface.
ALLOW_INSECURE_BIND=
GEMINI_API_KEY=
MAX_REQUEST_BODY_BYTES=1000000
# Uploaded cover images must fit inside MAX_REQUEST_BODY_BYTES as well as this.
MAX_COVER_BYTES=900000
MAX_TEXT_LENGTH=500000
MAX_SELECTOR_LENGTH=2000
MAX_IMPORT_LINKS=500
MAX_BROWSER_ACTIONS=50
MAX_BLOCK_SELECTORS=100
MAX_CONTENT_SELECTORS=20
MAX_ACTION_ATTEMPTS=20
MAX_ACTION_DELAY_MS=60000
MAX_VIEWPORT_DIMENSION=4096
MAX_SCREENSHOT_PIXELS=16000000
MAX_FETCHED_BYTES=10000000
FETCH_TIMEOUT_MS=30000
MAX_FETCH_REDIRECTS=5
MAX_BROWSER_CONCURRENCY=3
MAX_AI_CONCURRENCY=2
MAX_SCAN_CONCURRENCY=4
MAX_FRAMES=8
# How many times the reader-page importer may scroll before giving up on the
# page loading more chapters.
MAX_SCROLL_LOADS=12
# AI selector generation. Auto-detection takes the first of these that is set —
# local Ollama, then Gemini, then Mistral — so a self-hosted model is preferred
# over a billed API. AI_PROVIDER forces one (auto|ollama|gemini|mistral) when
# several are set or when the sidecar cannot run on this host.
AI_PROVIDER=
# Local Ollama endpoint. http/https only. Private addresses are expected and
# deliberately exempt from the SSRF policy: this is the operator's own endpoint.
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5-coder:7b
# Hosted alternatives. MISTRAL_MODEL defaults to mistral-large-latest.
MISTRAL_API_KEY=
MISTRAL_MODEL=
AI_REQUEST_TIMEOUT_MS=120000
MAX_AI_SKELETON_BYTES=60000
